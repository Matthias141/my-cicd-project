# =============================================================================
# my-cicd-project — Environment Variables (local development only)
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env — it is already in .gitignore.
#
# In deployed environments (dev/staging/prod), API_KEYS_JSON is NOT read
# from here - it's fetched from AWS Secrets Manager at Lambda cold start
# (see app/auth.py:_load_api_keys_from_secrets_manager, terraform/secrets.tf).
# This file only matters for `python main.py` / `pytest` on your machine.
#
# Deliberately left blank, not filled with a realistic-looking placeholder:
# a plausible-looking example value is exactly what caused a real secret
# to be committed to this repo before (see CLAUDE.md). Leave it empty and
# fill in your own local-only value after copying this file.
# =============================================================================

# JSON-encoded map of API keys - see terraform/variables.tf:api_keys_json
# for the exact schema. Optional: if unset, API_KEYS is just empty and
# every protected endpoint returns 401 (safe default, nothing crashes).
API_KEYS_JSON=
